theme = Apple Classic
font-family = "JetBrains Mono"
# background-opacity = 0.9
window-theme = system
unfocused-split-opacity = 0.6
copy-on-select = clipboard
focus-follows-mouse = true
scrollback-limit = 10000000
shell-integration = zsh
cursor-style = block
shell-integration-features = no-cursor
macos-titlebar-proxy-icon = hidden

# No multiplexing in Ghostty -- tmux handles splits/tabs/copy-mode.
# Wipe every default keybinding, then re-add only the essentials.
keybind = clear
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+q=quit

# App-level (not multiplexer) essentials
keybind = super+n=new_window
keybind = super+w=close_surface
keybind = super+enter=toggle_fullscreen
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size
keybind = super+shift+comma=reload_config

# cmd+backspace deletes the whole line: sends ctrl+u, which zsh binds to
# kill-whole-line (bash users would only get delete-to-start-of-line).
keybind = super+backspace=text:\x15
